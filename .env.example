# Copy to .env (or set in your host's dashboard). Never commit real secrets.
NODE_ENV=production
PORT=3000
BASE_URL=https://your-domain.ng
DATABASE_PATH=data/middleman.db

# Long random strings. APP_SECRET encrypts refund account numbers and PINs:
# changing it later makes existing ones unreadable.
APP_SECRET=
ADMIN_PASSWORD=

# mock | flutterwave
PAYMENT_PROVIDER=mock
FLW_SECRET_KEY=
FLW_WEBHOOK_HASH=
# Leave false until a lawyer, the bank and Flutterwave have approved the custody model in writing.
ALLOW_LIVE_PAYMENTS=false

# mock (manual rider links) | fez (not implemented yet)
LOGISTICS_PROVIDER=mock

FEE_PERCENT=1.5
FEE_MIN_NAIRA=100
FEE_CAP_NAIRA=2000
MAX_DEAL_NAIRA=300000
INSPECTION_HOURS=24
